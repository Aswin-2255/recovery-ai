# ==============================================================================
# RecoverAI - Environment Configuration Template
# Track 3: AI Revenue Recovery (Razorpay Buildathon)
# ==============================================================================

# Application Settings
APP_NAME="RecoverAI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL with SQLite fallback for offline dev/tests)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recoverai"
DATABASE_FALLBACK_SQLITE=true

# Razorpay Test Mode Credentials (NEVER USE LIVE CREDENTIALS)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"
RAZORPAY_MODE="test"

# AI / LLM Configuration (Provider-agnostic abstraction)
LLM_PROVIDER="gemini" # Options: gemini, openai, anthropic, mock
LLM_API_KEY="placeholder_llm_api_key"
LLM_MODEL="gemini-1.5-pro"
LLM_TEMPERATURE=0.2

# Policy Engine Constraints
MAX_RECOVERY_RETRIES=3
MIN_RECOVERY_CONFIDENCE=0.60
AUTO_RECOVERY_THRESHOLD_INR=50000.0
